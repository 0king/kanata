#|
kanata v1.12.0
ubuntu 26

Universal kanata config for all keyboards.

# Big question:
how to setup modifiers?
1. HRM (tap-hold)
2. one-shot
  1. hold space, trigger one-shot mods (jkl;) 🙅‍♂️
    Problems with this approach:
    To type `Q:`: To get capital q, hold space, then tap j, relese space, tap q. Now, to get colon, again hold space, tap j, tap ;
    My common shortcuts are meta + a, meta + w, meta + tab, meta + f4, meta + arrow. A and W are not on the same layer
  2. move one-shot mods to different layer - but this still has a problem - instead of holding shift, tap shift multiple times.
3. chords - tap two keys at once

# Layer triggers:

## hold
1. thumb keys = space (meta and alt keys can also be used)
2. capslock, escape (because it is placed at capslock)

- Caps Lock: tap = Esc, hold = Mouse layer
- Space: tap = Space, hold = Altt layer

## tap
1. meta + esc
2. meta + ccontrol + esc

# Layers:
1. altt
- Not using one shot mods (in their current form)
- HRMs in right side only
- esdf become Arrow keys

- key c becomes space
- home, end = h, g
- tab = t
- pageup, pagedown = r, v

- w = tilde
- q = backtick
- a = enter
- x = backspace
- z = delete
- F3 = Print Scr
- f11/f12 = volume up and down
- f1/f2 = brightness up and down
2. Mouse: hold capsock
3. Media: a easy layer for media playing. 
   arrows, volume, brighness
   Shortcut toggle = Meta + ESC
4. Bypass: bypass kanata completely. 
   Shortcut toggle = Meta + Ctrl + ESC

|#

(defcfg
  process-unmapped-keys yes
  linux-device-detect-mode keyboard-only
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defvar
  ;; Every key on the left side (Used for opposite-hand modifier checks)
  ;; spacec is NOT included in any hand
  l-hand (
    esc f1 f2 f3 f4 f5
    grv 1 2 3 4 5
    tab q w e r t
    caps a s d f g
    lsft z x c v b
    lctl lmet lalt
  )
  
  ;; Every key on the right side
  r-hand (
    f6 f7 f8 f9 f10 f11 f12
    6 7 8 9 0 - = bspc
    y u i o p [ ] bksl
    h j k l scln apos ret
    n m , . / rsft
    ralt rmet rctl
  )
)

(defalias
  ;; Layer toggles
  cl (tap-hold 0 200 esc (layer-while-held mouse))  ;; cl = capslock
  sp (tap-hold 0 200 spc (layer-while-held altt))   ;; sp = space
  
  ;; --- LAYER SWITCH ACTIONS ---
  bas (layer-switch base)
  byp (layer-switch bypass)
  med (layer-switch media)

  ;; --- FORK LOGIC ---
  ;; BASE: Meta+Ctrl+Esc -> Bypass | Meta+Esc -> Media | Esc -> @cl
  m-e-bas (fork @med @byp (lctl rctl))
  e-bas   (fork @cl @m-e-bas (lmet rmet))

  ;; MEDIA: Meta+Ctrl+Esc -> Bypass | Meta+Esc -> Base | Esc -> @cl
  m-e-med (fork @bas @byp (lctl rctl))
  e-med   (fork @cl @m-e-med (lmet rmet))

  ;; BYPASS: Meta+Ctrl+Esc -> Base | Meta+Esc -> Normal Esc | Esc -> Normal Esc
  m-e-byp (fork esc @bas (lctl rctl))
  e-byp   (fork esc @m-e-byp (lmet rmet))

  ;; --- oneshot mods ---
  ;; osm (one-shot 2000 rmet)
  ;; oss (one-shot 2000 rsft)
  ;; osc (one-shot 2000 rctl)
  ;; osa (one-shot 2000 ralt)

  ;; Right hand mods ONLY trigger if a left hand key is pressed
  ;; Activates $tap-action early if a key within $tap-keys is pressed before hold activates
  ;; "pressing another key on the same half of the keyboard... will activate an early tap action"
  j (tap-hold-release-keys 0 200 j rsft $r-hand)
  k (tap-hold-release-keys 0 200 k rctl $r-hand)
  l (tap-hold-release-keys 0 200 l ralt $r-hand)
  ; (tap-hold-release-keys 0 300 ; rmet $r-hand) 
  
  ;; Left hand mods ONLY trigger if a right hand key is pressed
  a (tap-hold-release-keys 0 300 a lmet $l-hand)
  s (tap-hold-release-keys 0 200 s lalt $l-hand)
  d (tap-hold-release-keys 0 200 d lctl $l-hand)
  f (tap-hold-release-keys 0 200 f lsft $l-hand)

  ;; --- MOUSE SPEEDS ---
  fst (movemouse-speed 500) 
  slw (movemouse-speed 20)  

  ;; Normal Mouse Cursor Movement
  mmu (movemouse-up 10 4)
  mmd (movemouse-down 10 4)
  mml (movemouse-left 10 4)
  mmr (movemouse-right 10 4)

  ;; Scrolling
  mwl (mwheel-left 100 30)
  mwd (mwheel-down 100 30)
  mwu (mwheel-up 100 30)
  mwr (mwheel-right 100 30)

  ;; Mouse clicks & Macros
  ml mlft
  mr mrgt
  cpy C-c
  pst C-v
)

;; layer keys = space, capslock, esc
;; HRMs
;; using fork
(deflayer base
  @e-bas _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  @e-bas @a   @s   @d   @f   _    _    @j   @k   @l   @;   _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _   _    _              @sp            _   _    _
)

;; hold space to trigger altt layer
;; key c becomes space
;; home, end = h, g
;; tab = t
;; pageup, pagedown = r, v
;; since we can only have one set of HRMs (right side), keep all other keys on the other side (left)

;; Problems: 
;;  1. cannot reach right function keys while pressing HRMs
(deflayer altt
  _    brdn brup  prnt  _    _     _     _     _     _     _     vold  volu
  _    f1   f2    f3    f4   f5    f6    f7    f8    f9    f10   f11   f12  _   ;; number row
  _    grv  S-grv up    pgup tab   _     _     _     _     _     _     _    _
  _    ret  left  down  rght end   home  _     _     _     _     _     _
  _    del  bspc  spc   pgdn _     _     _     _     _     _     _
  _    _    _     _     _    _     _
)

;; hold c/v to change cursor speed
;; keys m and n also scroll
;; ijkl = cursor
;; esdf = scroll
(deflayer mouse
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    @mwu _    _  @cpy @pst @mmu    _    _    _    _    _
  _    _    @mwl @mwd @mwr _  _    @mml @mmd @mmr  _    _    _
  _    _    _    @fst @slw _  @mwu @mwd  _  _  _    _
  _    _    _              @ml            _    _    _
)

;; MEDIA LAYER (Meta + ESC)
(deflayer media
  @e-med  _     _     _     _     _    _    _     _     _      _    _     _
  _       brdn  brup  _     _     _    _    _     _     _      _    vold  volu  _
  _       _     _     up    _     _    _    _     up    _      _    _     _     _
  @e-med  _     left  down  rght  _    _    left  down  rght  _    _     _
  _       _     _     _     _     _    _    _     _     _      _    _
  _       _     _           @sp             _     _     _
)

;; BYPASS LAYER (meta + ctrl + esc)
;; All keys revert to raw physical output except the exit forks. 
(deflayer bypass
  @e-byp _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  @e-byp _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ spc _ _ _
)

